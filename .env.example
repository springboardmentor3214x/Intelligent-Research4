# ==============================================================================
# Research Funding & Innovation Intelligence Platform (.env.example)
# ==============================================================================

# Database Connection (PostgreSQL with psycopg v3 driver)
DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/research_intelligence"

# JWT Authentication & Security
JWT_SECRET_KEY="generate-a-secure-random-64-character-hex-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Google OAuth2 Authentication (Optional for public deployment)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/oauth/google/callback"

# LLM & AI Synthesis (Groq Cloud API)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
